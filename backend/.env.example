DATABASE_URL=postgresql+asyncpg://user:pass@localhost/db

# Clerk identity provider (auth is only enforced once these are set).
# Configure a Clerk JWT template that adds `email`, `first_name`, `last_name`
# claims to the session token so users can be provisioned without a live API call.
# Provide EITHER a JWKS URL (production) OR a PEM public key (offline/tests).
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWKS_URL=
CLERK_JWT_PUBLIC_KEY=
CLERK_ISSUER=
# Comma-separated list of allowed `azp` values (frontend origins).
CLERK_AUTHORIZED_PARTIES=

# Rate limiting (falls back to in-process memory when REDIS_URL is unset).
REDIS_URL=
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_SENSITIVE=10/minute
