# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/fitness_db
# Optional: point the test suite at a different database. It builds its own
# schema (fitnessos_test) and drops it afterwards, so it never touches yours.
# TEST_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/fitness_db

# ---------------------------------------------------------------------------
# Clerk — the authentication authority
# ---------------------------------------------------------------------------
# From the Clerk dashboard: API keys. Never commit real values.
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Your Clerk Frontend API origin. This is the `iss` claim of every session
# token and must match exactly, including the scheme.
CLERK_ISSUER=https://your-instance.clerk.accounts.dev

# Networkless verification. Prefer the JWKS endpoint on your Frontend API host
# (NOT https://api.clerk.com/v1/jwks, which is the authenticated Backend API).
# Keys are fetched once per process and cached for an hour.
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
# Alternative to JWKS: paste the PEM public key from Clerk's JWT templates page.
# When set, this takes precedence and no network call is ever made.
CLERK_JWT_KEY=

# Comma-separated frontend origins allowed to mint session tokens for this API.
# Checked against the token's `azp` claim, and reused as the CORS allowlist.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# Clock-skew tolerance in seconds when validating exp/iat/nbf.
CLERK_JWT_LEEWAY_SECONDS=5

# ---------------------------------------------------------------------------
# Migration switches — both default to false, turn on deliberately
# ---------------------------------------------------------------------------
# Links a first-time Clerk identity to an existing local user with the same
# VERIFIED email. Turn on only while migrating pre-Clerk users, then turn off.
CLERK_LINK_EXISTING_USERS_BY_EMAIL=false

# Re-enables the pre-Clerk password endpoints (/auth/register, /login,
# /refresh, /logout) and HS256 access tokens. Off means those routes 404 and
# legacy tokens are rejected. JWT_SECRET_KEY is only needed when this is on.
LEGACY_PASSWORD_AUTH_ENABLED=false
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=Fitness Business OS
DEBUG=false
ECHO=false
